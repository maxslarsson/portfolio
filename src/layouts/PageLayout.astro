---
import "@/styles/global.css"
import BaseHead from "@/components/BaseHead.astro"
import Header from "@/components/Header.astro"
import { SITE } from "@/consts"

interface Props {
  title?: string
  description?: string
}

const { title, description = SITE.description } = Astro.props
---

<!doctype html>
<html
  lang="en"
  class="overflow-y-scroll antialiased motion-safe:scroll-smooth scheme-dark bg-black text-white/75"
>
  <head>
    <BaseHead title={title ? `${title} | ${SITE.title}` : SITE.title} description={description} />
  </head>
  <body class="flex min-h-dvh flex-col">
    <Header />
    <main class="flex flex-1 flex-col">
      <slot />
    </main>
  </body>
</html>
