---
import Arrow from "@/components/Arrow.astro"
import Container from "@/components/Container.astro"
import { SITE, SOCIALS } from "@/consts"
---

<footer class="relative bg-black">
  <section class="py-5">
    <Container class="flex justify-center sm:justify-end">
      <a
        href="#top"
        class="group flex items-center gap-1.5 rounded-sm border p-1.5 text-sm transition-colors border-white/20 hover:bg-white/10 hover:text-white"
      >
        <Arrow class="-rotate-90" />
        Back to top
      </a>
    </Container>
  </section>

  <section class="border-t py-5 border-white/25">
    <Container class="grid grid-cols-1 items-center gap-3 sm:grid-cols-2">
      <a href="/" class="flex w-fit items-center gap-1 justify-self-center font-semibold transition-colors sm:justify-self-start hover:text-white">
        {SITE.title}
      </a>
      <div class="flex flex-wrap justify-center gap-1 sm:justify-end">
        {SOCIALS.map(({ name, icon: Icon, href }) => (
          <a
            href={href}
            target="_blank"
            aria-label={`${SITE.title} on ${name}`}
            class="size-10 rounded-full p-2 transition hover:bg-white/20 hover:text-white"
          >
            <Icon class="size-full" />
          </a>
        ))}
      </div>
    </Container>
  </section>

  <section class="border-t py-5 text-center text-sm sm:text-left border-white/25">
    <Container>{`© ${new Date().getFullYear()} ${SITE.title}`}</Container>
  </section>
</footer>
