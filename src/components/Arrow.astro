---
// Right-pointing arrow whose shaft slides in on hover; the parent must be a `group`. Rotate via `class` for other directions.
interface Props {
  class?: string
}
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  class:list={["size-5 shrink-0", Astro.props.class]}
>
  <line x1="5" y1="12" x2="19" y2="12" class="translate-x-4 scale-x-0 transition-all group-hover:translate-x-1 group-hover:scale-x-100" />
  <polyline points="12 5 19 12 12 19" class="transition-all group-hover:translate-x-1" />
</svg>
