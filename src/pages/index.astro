---
import { Image } from "astro:assets"
import { Icon } from "astro-icon/components"
import headshot from "@/assets/headshot.png"
import Galaxy from "@/components/Galaxy.astro"
import { SITE, SOCIALS } from "@/consts"
import PageLayout from "@/layouts/PageLayout.astro"


---

<PageLayout>
  <Galaxy />

  <section class="relative min-h-svh w-full">
    <!-- top offsets put the horizon in the gap between the headshot and the prose; keep in sync with the content's top padding -->
    <div class="absolute inset-0 top-53 overflow-hidden md:top-73">
      <div class="absolute top-0 left-1/2 aspect-square min-h-svh w-[250vw] -translate-x-1/2 rounded-full bg-linear-to-b from-0% to-transparent to-5% p-px from-white/75">
        <div class="flex size-full justify-center overflow-hidden rounded-full p-px bg-black">
          <div class="h-20 w-full rounded-full blur-3xl bg-white/25"></div>
        </div>
      </div>
    </div>
    <div class="relative mx-auto w-full max-w-(--breakpoint-sm) px-5 pt-24 pb-16 md:pt-28">
      <div class="flex items-center gap-5 md:gap-8">
        <!-- same 1px gradient rim as the horizon above -->
        <div class="shrink-0 rounded-full bg-linear-to-b from-white/75 to-transparent p-px">
          <Image
            src={headshot}
            alt={SITE.title}
            width={176}
            densities={[1, 2]}
            loading="eager"
            class="size-28 rounded-full object-cover object-[50%_20%] md:size-44"
          />
        </div>
        <div>
          <p class="text-lg font-semibold opacity-75 md:text-xl lg:text-2xl">Hello, I am</p>
          <h1 class="text-2xl font-bold uppercase md:text-3xl lg:text-4xl text-white">{SITE.title}</h1>
        </div>
      </div>

      <article class="prose mt-14 max-w-none prose-invert">
        <p>
          I'm a senior at Cornell University studying computer science. I work on embedded software that is deployed
          everywhere.
        </p>
        <p>
          I am currently working on the flight software platform team at <a href="https://www.anduril.com" target="_blank">Anduril Industries</a>,
          focused on scaling embedded systems across vehicles and programs. Before that I interned
          at <a href="https://www.northwoodspace.io" target="_blank">Northwood Space</a>, where I built software-in-the-loop
          testing for their phased array antennas. I was also Software Subteam Lead for Cornell Rocketry, where I built our ground
          support software, including a custom Linux build that controls nitrous loading before launch.
        </p>
        <p>
          My expertise is centered on C++, Rust, Python, Nix, and the architecture of mission-critical,
          resource-constrained systems. I've written my own programming language and compiler in Rust,
          and a minimal embedded Linux distribution built on NixOS module conventions.
        </p>
        <p>Outside of work I play soccer, rock climb, grill, and watch Formula 1.</p>
      </article>

      <div class="-ml-2 mt-6 flex flex-wrap gap-1">
        {SOCIALS.map(({ name, icon, href }) => (
          <a
            href={href}
            target={href.startsWith("http") ? "_blank" : undefined}
            aria-label={name}
            data-contact-link
            data-contact-method={name}
            class="size-10 rounded-full p-2 transition hover:bg-white/20 hover:text-white"
          >
            <Icon name={icon} class="size-full" />
          </a>
        ))}
      </div>
    </div>
  </section>
</PageLayout>

<script>
  import posthog from "posthog-js"

  document.querySelectorAll<HTMLAnchorElement>("[data-contact-link]").forEach((link) => {
    link.addEventListener("click", () => {
      const contactMethod = link.dataset.contactMethod
      if (!contactMethod) return

      posthog.capture("contact_link_clicked", { contact_method: contactMethod })
    })
  })
</script>
