---
import Galaxy from "@/components/Galaxy.astro"
import PageLayout from "@/layouts/PageLayout.astro"
---

<PageLayout title="Page not found">
  <Galaxy />

  <section class="relative flex flex-1 items-center justify-center p-5 text-center">
    <div class="motion-safe:animate-fade-up">
      <p class="text-lg font-semibold opacity-75 md:text-xl lg:text-2xl">404</p>
      <h1 class="text-2xl font-bold text-white uppercase md:text-3xl lg:text-4xl">Lost in space</h1>
      <p class="text-sm opacity-75 md:text-base lg:text-lg">This page doesn't exist.</p>
      <a href="/" class="mt-5 inline-block rounded-sm bg-white px-4 py-2 text-xs text-black transition hover:opacity-75 md:text-sm lg:text-base">
        Back to home
      </a>
    </div>
  </section>
</PageLayout>
